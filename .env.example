# ==============================================================================
# COACH NINA PLATFORM ENVIRONMENT VARIABLES
# ==============================================================================

# Gemini AI Assistant API Key (Server-side ONLY; never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Admin Studio Authentication
ADMIN_PASSWORD=your_secure_admin_password_here
SESSION_SECRET=generate_a_random_32_character_secret_string_here
# Configurable Admin studio URL path (Default: /studio-control)
ADMIN_PATH=/studio-control

# Database (Supabase Postgres)
# When provided, all content, media metadata, and chat sessions persist to Supabase Postgres.
# When omitted in local development, a persistent local database is used automatically.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=coach-nina-media

# Optional Base URL for public links and previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
